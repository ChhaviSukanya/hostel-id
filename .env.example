# ---- Required ----
SECRET_KEY=replace-with-a-long-random-string      # python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_USER_ID=admin
ADMIN_PASSWORD=choose-a-strong-password           # creates the admin on first start; changing it here resets it
DATABASE_URL=postgresql://hostel:hostelpw@localhost:5432/hostel

# ---- Optional ----
DATA_DIR=./data                                   # photos, signatures, template preview, generated PDFs (back this up)
CORS_ORIGINS=http://localhost:5173
MAX_IMAGE_MB=5

# ---- Google (needed for photos on Drive, Excel export and ID generation) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
DRIVE_FOLDER_ID=                                  # the Drive folder where student images are stored
APPS_SCRIPT_URL=                                  # Web App URL ending in /exec
APPS_SCRIPT_SECRET=                               # same value as the API_SECRET script property
